# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPEN_AI_KEY: Required for OpenAI model calls (validation scoring and AI fixes).
# Users configure this via the Secrets panel in the AI Studio UI.
OPEN_AI_KEY="MY_OPEN_AI_KEY"

# TEST_USER: Authorized username for authentication.
# Configured via the Secrets panel in the AI Studio UI.
TEST_USER="MY_TEST_USER"

# TEST_PASSWORD: Authorized password for authentication.
# Configured via the Secrets panel in the AI Studio UI.
TEST_PASSWORD="MY_TEST_PASSWORD"


# --- SHARED STORAGE (plans and settings) ---------------------------------------
# STORAGE_DRIVER: "firestore" or "local". Leave unset to auto-detect - Firestore when a
# GCP project is resolvable (as on Cloud Run), the local-file driver otherwise.
# Set to "firestore" in production to fail loudly instead of silently degrading to a
# container disk that does not persist or share.
STORAGE_DRIVER="firestore"

# GCP_PROJECT_ID: Only needed if the metadata server cannot be reached (local testing
# against a real Firestore). On Cloud Run this is detected automatically.
# NOTE: this must be the project *ID*, not the display name. "ai-api-project" is the
# display name; the ID is "ai-api-project-465519".
# GCP_PROJECT_ID="ai-api-project-465519"

# FIRESTORE_DATABASE_ID: Defaults to "(default)". Set only if you created a named database.
# FIRESTORE_DATABASE_ID="(default)"

# GOOGLE_SERVICE_ACCOUNT_KEY: Fallback credentials, as service-account JSON or its base64
# form. Only needed if the Cloud Run runtime service account cannot be granted
# roles/datastore.user. Preferred setup uses the runtime service account and no key.
# GOOGLE_SERVICE_ACCOUNT_KEY=""

# --- SESSIONS AND ROLES ---------------------------------------------------------
# GOOGLE_CLIENT_ID: OAuth client ID (Web application) for "Sign in with Google". Not a
# secret. Its authorized JavaScript origins must include the address people use, e.g.
# https://plan-agent.digitalremedylabs.com (and http://localhost:3000 for development).
# Unset: only the team-password form is shown.
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"

# ALLOWED_EMAIL_DOMAINS: Workspace domains allowed to sign in with Google. Comma-separated.
# ALLOWED_EMAIL_DOMAINS="digitalremedy.com"

# ADMIN_EMAILS: Google accounts that may edit global settings and see named usage.
# Comma-separated. Setting it (or ADMIN_PASSWORD) locks settings to administrators.
# ADMIN_EMAILS="someone@digitalremedy.com"

# PASSWORD_LOGIN_ENABLED: Set to "false" to retire the team-password sign-in once Google
# sign-in is proven. Default: on.
# PASSWORD_LOGIN_ENABLED="true"

# ADMIN_PASSWORD: Entered at login to gain permission to edit global planning settings.
# If unset, EVERY signed-in user can change settings (the pre-existing behaviour).
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# SESSION_SECRET: HMAC key for the session cookie. If unset, a key is derived from
# TEST_USER/TEST_PASSWORD, which means rotating the password signs everyone out.
SESSION_SECRET="MY_SESSION_SECRET"
